# Copy to apps/web/.env.local (web), apps/api/.env (api) and packages/shared/.env (migrations).
# Never commit real values.

# --- Supabase (Postgres + sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=                # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # the "publishable" (anon) key
DATABASE_URL=                            # transaction pooler string, port 6543

# --- Required in production ---
CRON_SECRET=                             # any long random string; protects cron endpoints and signs unsubscribe links
PUBLIC_URL=https://your-domain.example   # the public origin, used in emails and links

# --- Optional: limits (the hosted service sets these; leave empty to self-host without any cap) ---
MONTHLY_EVENT_CAP=                       # max events per app per calendar month (UTC); empty = unlimited

# --- Optional: email (weekly report, alerts, sign-up notice) ---
RESEND_API_KEY=                          # without it, no emails are sent
SIGNUP_NOTIFY_EMAIL=                     # get an email when someone finishes sign-up
EMAIL_FROM_ALERTS=                       # e.g. "MyApp <alerts@yourdomain.com>" (verified in Resend)
EMAIL_FROM_REPORTS=                      # e.g. "MyApp <reports@yourdomain.com>"
