{
  "name": "fiscallm",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fiscallm/shared db:generate",
    "db:migrate": "pnpm --filter @fiscallm/shared db:migrate"
  }
}
