{
  "name": "fiscallm",
  "version": "0.8.1",
  "description": "Make sure every user of your AI app pays for their AI: limit AI usage by plan and track AI cost per user against RevenueCat or Stripe revenue. Plus `npx fiscallm` for Claude Code and Codex cost. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "fiscallm": "bin/fiscallm.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prices": {
      "types": "./dist/prices/index.d.ts",
      "import": "./dist/prices/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "ai-pricing",
    "usage-limits",
    "paywall",
    "revenuecat",
    "stripe",
    "ai-cost",
    "llm-cost",
    "cost-per-user",
    "openai",
    "anthropic",
    "gemini",
    "claude-code",
    "codex",
    "token-usage",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://fiscallm.com/docs",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "sync-prices": "node scripts/sync-prices.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
