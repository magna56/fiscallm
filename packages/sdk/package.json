{
  "name": "fiscallm",
  "version": "0.3.2",
  "description": "Track AI cost per user against subscription revenue. Zero-dependency SDK for your backend.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://fiscallm.com/docs",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
