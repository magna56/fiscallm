{
  "name": "fiscallm",
  "version": "0.1.1",
  "description": "Track AI cost per user against subscription revenue. Zero-dependency SDK for your backend.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magna56/ai_spend_book.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
