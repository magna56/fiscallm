{
  "name": "fiscallm",
  "version": "0.8.0",
  "description": "What your AI costs: `npx fiscallm` reads Claude Code and Codex logs on your machine; the SDK tracks AI cost per user and limits AI usage by plan. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "fiscallm": "bin/fiscallm.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prices": {
      "types": "./dist/prices/index.d.ts",
      "import": "./dist/prices/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "ai-cost",
    "llm-cost",
    "token-usage",
    "ccusage",
    "openai",
    "anthropic",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://fiscallm.com/docs",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "sync-prices": "node scripts/sync-prices.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
